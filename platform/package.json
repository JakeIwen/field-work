{
  "name": "fieldwork",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "npm run build && tsx app/server/index.ts",
    "serve": "tsx app/server/index.ts",
    "stop": "tsx app/scripts/stop.ts",
    "dev": "tsx app/server/index.ts --dev",
    "dev:client": "tsx app/scripts/dev-client.ts",
    "dev:server": "tsx app/scripts/dev-server.ts",
    "build": "npm run check:client-structure && tsc --noEmit && vite build",
    "deploy": "bash deploy/live.sh",
    "deploy:preview": "tsx app/scripts/deploy-preview.ts",
    "worktree": "bash scripts/worktree.sh",
    "test": "tsx --test --test-concurrency=4 app/tests/*.test.ts 'app/client/**/*.test.ts' && npm run test:client-structure && npm run test:backend-layout && npm run test:scripts",
    "test:native": "node scripts/run-locked.mjs native -- tsx --test --test-concurrency=2 app/tests/native/*.test.ts",
    "check:client-structure": "node scripts/check-client-structure.mjs",
    "test:client-structure": "node --test scripts/client-structure.test.mjs",
    "helpers:generate": "tsx app/scripts/generate-helper-contract.ts",
    "format": "prettier --write app/server app/shared app/tests app/scripts",
    "format:check": "prettier --check app/server app/shared app/tests app/scripts",
    "lint": "eslint app/server app/shared",
    "import": "tsx app/scripts/import.ts",
    "backup": "tsx app/scripts/backup.ts",
    "backup:verify": "tsx app/scripts/backup-verify.ts",
    "verify:codex": "tsx app/scripts/probe-codex.ts",
    "verify:release": "tsx app/scripts/verify-release.ts",
    "verify:browser": "tsx app/scripts/browser-check.ts",
    "fixture:browser-refactor": "tsx app/scripts/browser-refactor-fixture.ts",
    "service:prepare": "tsx app/scripts/service.ts prepare",
    "service:install": "npm run build && tsx app/scripts/service.ts install",
    "service:start": "tsx app/scripts/service.ts start",
    "service:stop": "tsx app/scripts/service.ts stop",
    "service:restart": "tsx app/scripts/service.ts restart",
    "service:status": "tsx app/scripts/service.ts status",
    "service:verify": "tsx app/scripts/service.ts verify",
    "service:uninstall": "tsx app/scripts/service.ts uninstall",
    "check": "node scripts/check.mjs",
    "check:backend-layout": "node scripts/check-backend-layout.mjs --root ..",
    "test:backend-layout": "node --test scripts/backend-layout.test.mjs scripts/check-runner.test.mjs",
    "test:scripts": "node --test scripts/run-locked.test.mjs scripts/worktree.test.mjs",
    "demo": "npm run build && tsx app/scripts/demo.ts",
    "demo:screenshots": "npm run build && tsx app/scripts/demo-screenshots.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@modelcontextprotocol/sdk": "1.32.1",
    "cheerio": "1.1.2",
    "chokidar": "4.0.3",
    "diff": "8.0.4",
    "esbuild": "0.25.12",
    "express": "5.1.0",
    "fflate": "0.8.3",
    "lucide-react": "0.468.0",
    "negotiator": "1.1.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "theme-kit": "github:JakeIwen/theme-kit#semver:^1.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/express": "5.0.3",
    "@types/jsdom": "21.1.7",
    "@types/negotiator": "0.6.5",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "domhandler": "5.0.3",
    "eslint": "10.11.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.9",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6"
  }
}
