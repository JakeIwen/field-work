[Unit]
Description=Fieldwork employment search
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fieldwork
Group=fieldwork
WorkingDirectory=/opt/fieldwork/platform
ExecStart=/usr/bin/node --import tsx app/server/index.ts
Environment=NODE_ENV=production
Environment=FIELDWORK_CLOUD_ACCESS=1
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HOME=/var/lib/fieldwork
Environment=SHELL=/bin/bash
Environment=PORT=4317
Environment=JOB_SEARCH_ROOT=/var/lib/fieldwork/workspace
Environment=JOB_SEARCH_DATA=/var/lib/fieldwork/workspace/.local/job-search
Environment=CODEX_HOME=/var/lib/fieldwork/.codex
Environment=FIELDWORK_SERVICE_LABEL=fieldwork.service
Environment=FIELDWORK_SERVICE_SCOPE=system
EnvironmentFile=/etc/fieldwork/fieldwork.env
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/fieldwork
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
